doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    )

    title デッキ編集

  body.bg-light

    nav.navbar.navbar-dark.bg-primary.mb-4
      .container
        span.navbar-brand
          i.bi-pencil-square.me-2
          | デッキ編集

    .container

      .row.justify-content-center
        .col-md-6

          .card.shadow-sm
            .card-body

              h4.mb-4 デッキ情報編集

              form(method="POST" action=`/decks/${deck.id}/edit`)

                .mb-3
                  label.form-label デッキ名

                  input.form-control(
                    type="text"
                    name="name"
                    value=deck.name
                  )

                .d-flex.gap-2

                  button.btn.btn-primary(type="submit")
                    i.bi-check-lg.me-1
                    | 更新

                  a.btn.btn-outline-secondary(href="/decks")
                    i.bi-arrow-left.me-1
                    | 戻る