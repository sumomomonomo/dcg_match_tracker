doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous"
    )

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css"
    )

    title デッキ管理

  body.bg-light

    nav.navbar.navbar-dark.bg-primary.mb-4
      .container
        span.navbar-brand
          i.bi-collection.me-2
          | デッキ管理

    .container

      a.btn.btn-outline-secondary.mb-3(href="/")
        i.bi-arrow-left.me-1
        | トップへ

      .card.mb-4.shadow-sm
        .card-body

          h5.card-title デッキ追加

          form(method="POST" action="/decks" class="d-flex gap-2 align-items-center")
            input.form-control(type="text" name="name" placeholder="デッキ名を入力")

            button.btn.btn-primary.flex-shrink-0(type="submit")
              i.bi-plus-lg.me-1
              | 追加

      .card.shadow-sm
        .card-body

          h5.card-title 登録済みデッキ

          if decks.length === 0
            p.text-muted まだデッキがありません
          else
            ul.list-group
              each deck in decks
                li.list-group-item.d-flex.justify-content-between.align-items-center
                  span
                    i.bi-cpu.me-2
                    | #{deck.name}

                  .d-flex.gap-2
                    a.btn.btn-sm.btn-outline-primary(
                      href=`/decks/${deck.id}/edit`
                    )
                      i.bi-pencil.me-1
                      | 編集

                    form(method="POST" action=`/decks/${deck.id}/delete`)
                      button.btn.btn-sm.btn-outline-danger(
                        type="submit"
                        onclick="return confirm('本当に削除する？')"
                      )
                        i.bi-trash.me-1
                        | 削除