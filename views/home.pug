doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous"
    )

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css"
    )

    title DCG Match Tracker

  body.bg-light

    nav.navbar.navbar-dark.bg-primary.mb-4
      .container
        span.navbar-brand.mb-0.h1
          i.bi-bar-chart-fill.me-2
          | DCG Match Tracker

    .container

      .mb-4
        h2 ようこそ #{user.username}

      .row.g-3.mb-4

        .col-md-4
          .card.shadow-sm
            .card-body.text-center
              h5.card-title 総戦績
              h2 #{totalMatches}
              p.text-muted 戦

        .col-md-4
          .card.shadow-sm
            .card-body.text-center
              h5.card-title 勝利数
              h2.text-success #{winCount}
              p.text-muted 勝

        .col-md-4
          .card.shadow-sm
            .card-body.text-center
              h5.card-title 勝率
              h2.text-primary #{winRate}%
              p.text-muted Win Rate

      if favoriteDeck
        .card.shadow-sm.mb-4
          .card-body
            h4.card-title
              i.bi-trophy-fill.text-warning.me-2
              | 一番使ったデッキ

            p.mb-1
              strong #{favoriteDeck.name}

            p.mb-1 使用回数: #{favoriteDeck.totalMatches}

            p.mb-0 勝率: #{favoriteDeck.winRate}%

      .card.shadow-sm.mb-4
        .card-body
          h4.card-title 最近5戦

          each match in recentMatches
            if match.isWin
              span.fs-2.text-success.me-2 ○
            else
              span.fs-2.text-danger.me-2 ×

      .card.shadow-sm
        .card-body

          h4.card-title メニュー

          .d-grid.gap-2

            a.btn.btn-outline-primary(href="/decks")
              i.bi-collection.me-2
              | デッキ管理

            a.btn.btn-outline-success(href="/matches")
              i.bi-list-check.me-2
              | 戦績管理

            a.btn.btn-outline-warning(href="/analysis")
              i.bi-bar-chart-line.me-2
              | 分析

            a.btn.btn-outline-danger(href="/logout")
              i.bi-box-arrow-right.me-2
              | ログアウト

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous"
    )