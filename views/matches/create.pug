doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    title 戦績編集

  body.bg-light

    .container.mt-4

      h1 戦績編集

      form(method="POST" action=`/matches/${match.id}/edit`)

        .mb-3
          label.form-label 自分のデッキ
          select.form-select(name="myDeckId")
            each deck in decks
              option(value=deck.id selected=(deck.id == match.myDeckId))= deck.name

        .mb-3
          label.form-label 相手デッキ
          input.form-control(type="text" name="enemyDeckName" value=match.enemyDeckName)

        .mb-3
          label.form-label 勝敗
          select.form-select(name="isWin")
            option(value="true" selected=match.isWin) 勝ち
            option(value="false" selected=!match.isWin) 負け

        .mb-3
          label.form-label 先攻後攻
          select.form-select(name="playOrder")
            option(value="FIRST" selected=(match.playOrder === "FIRST")) 先攻
            option(value="SECOND" selected=(match.playOrder === "SECOND")) 後攻

        .mb-3
          label.form-label メモ
          textarea.form-control(name="memo")= match.memo

        .d-flex.gap-2
          button.btn.btn-primary(type="submit") 更新
          a.btn.btn-secondary(href="/matches") 戻る